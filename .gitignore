# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/

# Reports / build artifacts
reports/*.md
reports/*.html
!reports/.gitkeep

# Editor / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Secrets — never commit API keys
.env
*.key

# Presentation build artifacts
presentation/node_modules/
presentation/render/
presentation/video/
presentation/package-lock.json
presentation/voiceover_*.wav

# Local backups & scratch (kept on disk, not pushed)
presentation/video_backup_*/
presentation/*_backup*.mp4
presentation/_gen_*.py
# Heavy video build intermediates (final mp4 is committed; narration mp3s kept)
presentation/vo/*.mp4
presentation/vo/*.png
